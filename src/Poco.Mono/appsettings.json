{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Tariffs": {
    "EU-Low": "0.020",
    "EU-Medium": "0.035",
    "EU-High": "0.060",
    "US-Low": "0.025",
    "US-Medium": "0.040",
    "US-High": "0.070"
  },
  "DemoIdentities": {
    "demo-agent-key": {
      "Name": "agent",
      "Permissions": [
        "quotes:create",
        "policies:read",
        "renewals:assess",
        "mcp:use",
        "policies:issue"
      ]
    },
    "demo-adjuster-key": {
      "Name": "adjuster",
      "Permissions": [
        "claims:triage",
        "claims:read",
        "policies:read",
        "mcp:use",
        "claims:approve"
      ]
    },
    "demo-viewer-key": {
      "Name": "viewer",
      "Permissions": [
        "policies:read",
        "claims:read"
      ]
    },
    "demo-admin-key": {
      "Name": "admin",
      "Permissions": [
        "quotes:create",
        "claims:triage",
        "claims:read",
        "policies:read",
        "renewals:assess",
        "mcp:use",
        "claims:approve",
        "claims:approve:large",
        "policies:issue"
      ]
    }
  }
}
